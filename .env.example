# ---- Database (Neon Postgres) ----
# Use sslmode=verify-full to keep certificate verification under pg v9.
# (pg v8 silently treats `require` as `verify-full`; v9 will drop verification.)
DATABASE_URL="postgres://USER:PASSWORD@HOST/db?sslmode=verify-full&channel_binding=require"
# Used by `prisma migrate` (direct connection, bypasses pooler)
DIRECT_URL="postgres://USER:PASSWORD@HOST/db?sslmode=verify-full&channel_binding=require"

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# In production, set to https://your-domain. Leave empty in dev — Auth.js infers it.
AUTH_URL=""

# Sign-in providers — configure at least ONE so the first user can sign in.
# Google OAuth (register a client in the Google Cloud Console; redirect URI
# <app-url>/api/auth/callback/google):
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email magic links via Resend (simplest — just an API key):
AUTH_RESEND_KEY=""
RESEND_FROM="Stacks <noreply@your-domain>"

# Registration mode. Default OPEN (anyone can sign in; the first user on a fresh
# database becomes the instance admin). Set to "false" for invite-only.
OPEN_SIGNUP="true"

# Invite-only mode only: optionally let extra addresses self-serve without an
# invitation — comma/space-separated full emails and/or domain suffixes
# (e.g. "founder@acme.com, @acme.com"). Empty = invitation required.
SIGNUP_ALLOWLIST=""

# ---- Real-time (Pusher Channels) ----
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ---- File storage (Cloudflare R2 / S3-compatible) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="stacks-attachments"
# Public read URL for objects (R2 custom domain or signed URLs)
R2_PUBLIC_BASE_URL=""

# Public base URL of your deployment — absolute links in emails + OAuth metadata.
# Leave as localhost for dev; set to your own domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Cron (Vercel cron jobs send Authorization: Bearer $CRON_SECRET) ----
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ---- Semantic layer (P4.3, optional like Pusher/R2/Resend) ----
# Voyage AI embeddings key — without it the semantic layer silently no-ops
# (find_similar_tasks returns empty with a notice, no duplicate suggestions).
VOYAGE_API_KEY=""
# STACKS_EMBEDDINGS_MODEL="voyage-3.5-lite"
