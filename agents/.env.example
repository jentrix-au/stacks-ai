# Stacks MCP endpoint. Local dev server by default; production is
# https://your-domain.com/api/mcp.
STACKS_MCP_URL=http://localhost:3000/api/mcp

# PAT from /account/tokens. Least privilege per agent:
#   standup        → scope: read
#   bug-triage     → scopes: read, write
#   crm-follow-up  → scopes: read, write
# Give the token an agent display name + emoji (P4.1) so its actions are
# badged in the UI, and pin it to one workspace.
STACKS_TOKEN=tm_...

# Agent runtime: "claude" (default — Claude Agent SDK) or "codex" (OpenAI
# Codex SDK, runs on your ChatGPT subscription via `codex login`; no OpenAI
# API key needed).
# STACKS_AGENT_PROVIDER=codex

# Claude runtime auth — read automatically from the environment. Not needed
# when STACKS_AGENT_PROVIDER=codex.
ANTHROPIC_API_KEY=sk-ant-...

# bug-triage only: the secret of the workspace webhook pointing at this
# receiver (events: task.created).
STACKS_WEBHOOK_SECRET=whsec_...
# bug-triage listen port (default 8787).
# PORT=8787

# standup only (optional): post the digest to a Slack incoming webhook.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional overrides. STACKS_AGENT_MODEL applies to the ACTIVE provider —
# claude defaults to claude-opus-4-8; codex defaults to Codex's current
# recommended model when unset.
# STACKS_AGENT_MODEL=claude-opus-4-8
# STACKS_AGENT_VERBOSE=1
